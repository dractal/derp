# main.tf — well-lit path Terraform module wiring for {{ layout.env }}.
# Generated by `derp init --infra`. Safe to edit; rerun `derp env pull {{ layout.env }}`
# after `terraform apply` to sync outputs into `.env.{{ layout.env }}`.

module "derp" {
  source  = "{{ module_source }}"
  version = "{{ module_version }}"

  app_name    = "{{ layout.choices.app_name }}"
  environment = "{{ layout.env }}"
  tier        = "{{ layout.tier }}"
  region      = "us-east"

  # Vendor provisioning credentials (used by Terraform itself, not relayed to derp).
{% for cred in layout.vendor_credentials() %}
  {{ cred.name }} = var.{{ cred.name }}
{% endfor %}

  # Per-service mode + inputs.
{% for spec in well_lit_services %}
{%   set mode = layout.choices.mode_for(spec.key) %}
  mode_{{ spec.key.value }} = "{{ mode.value }}"
{%   if mode == ServiceMode.IMPORT %}
{%     for imp in spec.import_resources %}
  {{ imp.var_name }} = var.{{ imp.var_name }}
{%     endfor %}
{%   elif mode == ServiceMode.BYO %}
{%     for byo in spec.byo_credentials %}
  {{ byo.var_name }} = var.{{ byo.var_name }}
{%     endfor %}
{%   endif %}

{% endfor %}
}

# TF 1.5+ declarative imports — adopt existing resources into Terraform state
# on the next `terraform apply`. Safe to leave even after import completes;
# Terraform tracks the import and won't re-import the same resource.
{% set has_imports = false %}
{% for spec, var_name, example in layout.import_variables() %}
import {
  to = module.derp.{{ spec.key.value }}.this
  id = var.{{ var_name }}
}

{% set has_imports = true %}
{% endfor %}
{% if not has_imports %}
# (no Import-mode services in this environment)
{% endif %}
