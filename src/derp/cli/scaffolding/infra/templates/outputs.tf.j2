# outputs.tf — re-exports the module's env_vars map. `derp env pull <env>`
# reads `terraform output -json` from this directory and writes `.env.<env>`.

output "env_vars" {
  description = "Env vars consumed by derp via $VAR_NAME references in derp.toml"
  value       = module.derp.env_vars
  sensitive   = true
}
